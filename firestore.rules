rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function dn() { return request.auth != null; }
    function coHoSo() { return dn() && exists(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)); }
    function toi() { return get(/databases/$(database)/documents/nguoiDung/$(request.auth.uid)).data; }
    function laQTV() { return coHoSo() && toi().vaiTro == 'qtv' && toi().khoa != true; }
    function laGV() { return coHoSo() && toi().vaiTro in ['gv', 'qtv'] && toi().khoa != true; }
    function laHS() { return coHoSo() && toi().khoa != true; }
    function bayGio() { return request.time.toMillis(); }
    function lopHocToi() { return toi().get('lopHoc', []); }   // lớp học phần của SV
    function lopDayToi() { return toi().get('lopDay', []); }   // lớp học phần GV dạy
    // Bài làm: SV chỉ ghi các trường của mình; điểm và dấu vết mở khóa chỉ GV ghi (SV chỉ được để nguyên hoặc xóa khi làm lại)
    function truongHS() { return ['deGiaoId','uid','hoTen','maHS','lop','cau','chon','batDau','capNhat','phien','roi','daNop','lanNop','maDe','lichSu','nopLuc','lyDo','dangRoi']; }
    function truongGV() { return ['diemChot','dung','diemSua','ghiChuDiem','roiCu','moKhoa']; }
    function giuGV(k) { return !(k in request.resource.data) || (k in resource.data && request.resource.data[k] == resource.data[k]); }
    function hsKhongDungDiem() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(truongHS().concat(truongGV()))
        && giuGV('diemChot') && giuGV('dung') && giuGV('diemSua') && giuGV('ghiChuDiem') && giuGV('roiCu') && giuGV('moKhoa'); }
    function chu(k, n) { return !(k in request.resource.data) || (request.resource.data[k] is string && request.resource.data[k].size() <= n); }
    function deGiao(id) { return get(/databases/$(database)/documents/deGiao/$(id)).data; }

    // Hồ sơ người dùng. SV: lopHoc = [id lớp học phần], nganh = lớp hành chính. GV: lopDay = [id lớp dạy].
    match /nguoiDung/{uid} {
      allow read: if dn() && (request.auth.uid == uid || laGV());
      allow create: if laQTV()
        || (dn() && request.auth.uid == uid && uid == 'EyKqi3Iyn1OsfVHmbe3ATpmGfJl2' && request.resource.data.vaiTro == 'qtv')
        // GV tạo tài khoản SV, xếp vào lớp mình dạy
        || (laGV() && request.resource.data.vaiTro == 'hs' && request.resource.data.get('lopHoc', []).size() > 0
            && request.resource.data.lopHoc.hasOnly(lopDayToi()));
      allow update: if laQTV()
        // GV thêm / bỏ SV (bất kì) vào / khỏi lớp mình dạy
        || (laGV() && resource.data.vaiTro == 'hs'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lopHoc'])
            && request.resource.data.lopHoc.toSet().difference(resource.data.get('lopHoc', []).toSet()).hasOnly(lopDayToi())
            && resource.data.get('lopHoc', []).toSet().difference(request.resource.data.lopHoc.toSet()).hasOnly(lopDayToi()))
        // GV sửa / khóa SV đang học lớp mình
        || (laGV() && resource.data.vaiTro == 'hs' && resource.data.get('lopHoc', []).hasAny(lopDayToi())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hoTen', 'maHS', 'nganh', 'khoa']))
        // GV ghi lớp mới tạo vào danh sách lớp dạy của mình (chỉ lớp có tên mình trong gv); bỏ lớp thì tự do
        || (laGV() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lopDay', 'lopVuaDoi'])
            && request.resource.data.lopDay.toSet().difference(resource.data.get('lopDay', []).toSet()).hasOnly([request.resource.data.get('lopVuaDoi', '')])
            && (request.resource.data.lopDay.toSet().difference(resource.data.get('lopDay', []).toSet()).size() == 0
                || get(/databases/$(database)/documents/lop/$(request.resource.data.lopVuaDoi)).data.gv.hasAny([request.auth.uid])))
        // Tự sửa: đánh dấu đã đổi mật khẩu lần đầu, ảnh đại diện (≤ 60 KB), tên gọi và lời chào ở trang chủ
        || (dn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doiMatKhau', 'anhDaiDien', 'tenGoi', 'loiChao'])
            && request.resource.data.get('doiMatKhau', false) == false
            && request.resource.data.get('anhDaiDien', '').size() < 60000
            && request.resource.data.get('tenGoi', '').size() <= 30 && request.resource.data.get('loiChao', '').size() <= 80);
      allow delete: if laQTV();
    }

    // Cài đặt: "chung" (tên miền email) ai cũng đọc để đăng nhập bằng mã SV; "rieng" (mật khẩu khởi tạo) cần đăng nhập
    match /cauHinh/{id} {
      allow read: if id == 'chung' || laHS();
      allow write: if laQTV();
    }

    // Lớp học phần: GV tự tạo (gv = [mình]); QTV gán thêm GV, xóa mọi lớp
    match /lop/{id} {
      allow read: if laHS();
      allow create: if laQTV() || (laGV() && request.resource.data.gv == [request.auth.uid] && request.resource.data.taoBoi == request.auth.uid);
      allow update: if laQTV() || (laGV() && resource.data.gv.hasAny([request.auth.uid]) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ten']));
      allow delete: if laQTV() || (laGV() && resource.data.get('taoBoi', '') == request.auth.uid);
    }

    // Đề giao cho lớp học phần (lop = id lớp)
    match /deGiao/{id} {
      allow read: if laGV() || (laHS() && resource.data.lop in lopHocToi());
      allow create: if laQTV() || (laGV() && request.resource.data.gvUid == request.auth.uid && request.resource.data.lop in lopDayToi());
      allow update, delete: if laQTV() || (laGV() && resource.data.gvUid == request.auth.uid);
    }

    // Đáp án của đề giao: SV trong lớp chỉ đọc được sau giờ đóng đề
    match /dapAnDe/{id} {
      allow read: if laGV() || (laHS() && resource.data.lop in lopHocToi()
        && (bayGio() > resource.data.get('dapAnLuc', resource.data.dongLuc)
            // bài tập "xem đáp án ngay sau khi nộp": SV đã nộp ít nhất 1 lần
            || (resource.data.get('hienDapAn', 'sau-han') == 'sau-nop'
                && exists(/databases/$(database)/documents/baiNop/$(id + '_' + request.auth.uid))
                && get(/databases/$(database)/documents/baiNop/$(id + '_' + request.auth.uid)).data.get('lanNop', 0) > 0)));
      allow write: if laGV();
    }

    // Lời giải chi tiết của đề giao: SV trong lớp chỉ đọc khi GV đã bật "mo"
    match /loiGiaiDe/{id} {
      allow read: if laGV() || (laHS() && resource.data.lop in lopHocToi() && resource.data.mo == true);
      allow write: if laGV();
    }

    // Bài làm: mã = <mã đề giao>_<uid>; chỉ làm trong giờ mở đề, nộp rồi không sửa; GV thu bài, chốt / sửa điểm
    match /baiNop/{id} {
      allow read: if laGV() || (dn() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if laQTV() || (laHS() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(truongHS())
        && id == request.resource.data.deGiaoId + '_' + request.auth.uid
        && deGiao(request.resource.data.deGiaoId).lop in lopHocToi()
        && bayGio() >= deGiao(request.resource.data.deGiaoId).moLuc
        && bayGio() <= deGiao(request.resource.data.deGiaoId).dongLuc);
      allow update: if laGV() || (laHS() && resource.data.uid == request.auth.uid
        && hsKhongDungDiem()
        // chưa nộp; hoặc bài tập còn lượt làm lại
        && (resource.data.daNop != true
            || (deGiao(resource.data.deGiaoId).get('loai', 'kiem-tra') == 'bai-tap'
                && (deGiao(resource.data.deGiaoId).get('soLanLam', 1) == 0 || resource.data.get('lanNop', 0) < deGiao(resource.data.deGiaoId).get('soLanLam', 1))))
        && request.resource.data.get('lanNop', 0) >= resource.data.get('lanNop', 0)
        && request.resource.data.uid == resource.data.uid && request.resource.data.deGiaoId == resource.data.deGiaoId
        && bayGio() <= deGiao(resource.data.deGiaoId).dongLuc + 300000);
      allow delete: if laGV();
    }

    // Nhật ký hoạt động: người đã đăng nhập chỉ ghi được dòng của chính mình; chỉ QTV đọc, xóa dòng cũ; không ai sửa
    match /nhatKy/{id} {
      allow create: if dn() && request.resource.data.keys().hasOnly(['luc','uid','ten','vaiTro','hd','ct','doiTuong','ban'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.luc is int
        && request.resource.data.hd is string && request.resource.data.hd.size() <= 30
        && chu('ten', 80) && chu('vaiTro', 10) && chu('ct', 300) && chu('doiTuong', 120) && chu('ban', 20);
      allow read, delete: if laQTV();
      allow update: if false;
    }

    // Báo lỗi nội dung
    match /baoLoi/{id} {
      allow create: if dn() && request.resource.data.keys().hasOnly(['loai','kieu','noiDung','ten','uid','vaiTro','banApp','luc','ma','loaiMuc','ghiChu','tieuDe'])
        && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
        && chu('noiDung', 2000) && chu('ten', 100) && chu('kieu', 30) && chu('loai', 30) && chu('vaiTro', 10) && chu('banApp', 20)
        && chu('ma', 120) && chu('loaiMuc', 30) && chu('ghiChu', 500) && chu('tieuDe', 200);
      allow read, update, delete: if laGV();
    }
  }
}
